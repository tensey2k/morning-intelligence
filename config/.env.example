# Morning Intelligence Assistant - Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# TELEGRAM (Required)
# =============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# =============================================================================
# LLM PROVIDER - OpenRouter (Recommended: Claude 3.5 Sonnet / GPT-4o)
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Alternative models: openai/gpt-4o, google/gemini-1.5-pro, meta-llama/llama-3.1-70b-instruct

# =============================================================================
# MARKET DATA APIs
# =============================================================================
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# Twelve Data (optional, for real-time oil/commodities)
# TWELVE_DATA_API_KEY=your_twelve_data_key_here

# =============================================================================
# SCHEDULING & TIMEZONE
# =============================================================================
TIMEZONE=America/Toronto
BRIEFING_HOUR=7
BRIEFING_MINUTE=0
SCHEDULE_WEEKDAYS_ONLY=false

# =============================================================================
# LOCATION SETTINGS
# =============================================================================
WEATHER_CITY=Montreal
WEATHER_COUNTRY=Canada
WEATHER_LATITUDE=45.5017
WEATHER_LONGITUDE=-73.5673
# Optional: Moroccan city for dual weather
MOROCCO_WEATHER_CITY=Casablanca
MOROCCO_WEATHER_COUNTRY=Morocco
MOROCCO_WEATHER_LATITUDE=33.5731
MOROCCO_WEATHER_LONGITUDE=-7.5898

# =============================================================================
# LANGUAGE & OUTPUT
# =============================================================================
DEFAULT_LANGUAGE=en
ENABLED_LANGUAGES=en,fr,ar
BRIEFING_MODE=full  # compact, full, detailed

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///./data/morning_intelligence.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost/dbname

# =============================================================================
# DELIVERY SETTINGS
# =============================================================================
MAX_MESSAGE_LENGTH=4096
SPLIT_LONG_MESSAGES=true
ENABLE_MARKDOWN=true

# =============================================================================
# COST CONTROLS
# =============================================================================
MAX_LLM_TOKENS_PER_BRIEFING=8000
MAX_API_CALLS_PER_RUN=50